{
    "name": "eor_bah545/eorbahapi",
    "version": "0.1.0",
    "description": "EORBAH API est un framework web PHP moderne, rapide et haute performance, conçu pour construire des API avec une syntaxe épurée, inspiré de frameworks modernes comme Express.js et FastAPI.",
    "keywords": [
        "EorbahAPI",
        "sdk",
        "api-php",
        "php",
        "client",
        "fastapi-alternative",
        "template-twig",
        "php-web",
        "php-web-frameworks-apis"
    ],
    "homepage": "https://github.com/EORBAH/EorbahAPI",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "EORBAH",
            "email": "eor.bah545@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/EORBAH/EorbahAPI/issues",
        "source": "https://github.com/EORBAH/EorbahAPI"
    },
    "require": {
        "twig/twig": "^3.0",
        "firebase/php-jwt": "^7.0",
        "hvatum/oauth2-openid-connect-client": "^0.2.2",
        "predis/predis": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "Eorbahapi\\": "src/"
        },
        "files": [
            "src/Responses/JSONResponse.php" 
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Eorbahapi\\Tests\\": "tests/",
            "Eorbahapi\\Examples\\": "examples/"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "vlucas/phpdotenv": "^5.6"
    }
}
